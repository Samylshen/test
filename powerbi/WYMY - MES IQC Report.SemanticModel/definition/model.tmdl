model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures: true
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	annotation PBI_ProTooling = ["DevMode"]

	ref table 'Date'
	ref table Material
	ref table Vendor
	ref table Batch
	ref table Plant
	ref table 'UD Code'
	ref table 'Inspection Characteristic'
	ref table 'Defect Code'
	ref table 'Inspection Lot'
	ref table 'Inspection Result'
	ref table 'Inspection Defect'
