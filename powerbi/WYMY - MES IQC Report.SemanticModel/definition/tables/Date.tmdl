/// Date dimension (marked as date table). Must be a physical Delta table in the Lakehouse - Direct Lake does not support DAX calculated date tables.
table 'Date'
	lineageTag: c41ee29e-aa08-47e8-a4a2-b7d0b59d1135
	dataCategory: Time

	/// Surrogate key (yyyyMMdd). Join key for all fact date roles.
	column DateKey
		dataType: int64
		isHidden: true
		formatString: 0
		lineageTag: 4c19b8c9-6fa7-47ed-98f8-6a43b5085705
		summarizeBy: none
		sourceColumn: DateKey

	/// Calendar date. Key column used to mark this table as the model date table.
	column Date
		dataType: dateTime
		isKey: true
		formatString: Short Date
		lineageTag: e30b2b4d-4555-4fba-a43f-28a3f7ced63e
		summarizeBy: none
		sourceColumn: Date

	column Year
