	column BatchKey
		dataType: int64
		isHidden: true
		formatString: 0
		lineageTag: 0870c336-8ee0-49a0-84fd-4838906cad4b
		summarizeBy: none
		sourceColumn: BatchKey

	column PlantKey
		dataType: int64
		isHidden: true
		formatString: 0
		lineageTag: 1a772e52-a818-420a-a3a8-469628a14f26
		summarizeBy: none
		sourceColumn: PlantKey

	column UDCodeKey
		dataType: int64
		isHidden: true
		formatString: 0
		lineageTag: e0b78ff7-3320-46a7-9270-e9741907b545
		summarizeBy: none
		sourceColumn: UDCodeKey

	/// Goods receipt date role. Active relationship to the Date table.
	column GRDateKey
		dataType: int64
		isHidden: true
		formatString: 0
		lineageTag: 6441df8a-5878-4431-aca9-ac1dadb3cb7e
		summarizeBy: none
		sourceColumn: GRDateKey

	/// Usage decision date role. Inactive relationship, activated via USERELATIONSHIP.
	column UDDateKey
		dataType: int64
		isHidden: true
		formatString: 0
		lineageTag: 6b13d1f4-9ec7-4935-a8f4-ded34e2c4726
		summarizeBy: none
		sourceColumn: UDDateKey

	column PurchaseOrder
		dataType: string
		lineageTag: edd1fa1b-57e3-43c8-9bd8-4c441572ef7d
		summarizeBy: none
		sourceColumn: PurchaseOrder

	column PurchaseOrderItem
		dataType: string
		lineageTag: 4544591d-bff6-40fc-b1f4-3bf68b3d0a70
		summarizeBy: none
		sourceColumn: PurchaseOrderItem

	/// Inbound delivery from process 03 (VL31N).
	column InboundDeliveryNumber
		dataType: string
		lineageTag: 3afef7ae-dd38-4ccf-96f3-b1aa45d90ef1
		summarizeBy: none
		sourceColumn: InboundDeliveryNumber

	column HandlingUnitNumber
		dataType: string
		lineageTag: 07c500d2-fccc-4ba3-bb05-f38568af620d
		summarizeBy: none
		sourceColumn: HandlingUnitNumber

	column LotQuantity
		dataType: double
		formatString: #,##0.00
		lineageTag: 37b808f5-ed63-4d2b-88eb-03655e7e6654
		summarizeBy: sum
		sourceColumn: LotQuantity

	column InspectedQuantity
		dataType: double
		formatString: #,##0.00
		lineageTag: 3409edd3-f013-4db7-adda-65514267cc76
		summarizeBy: sum
		sourceColumn: InspectedQuantity

	column AcceptedQuantity
		dataType: double
		formatString: #,##0.00
		lineageTag: 0e8090b0-71d4-43e9-b24a-21c8be12cbdb
		summarizeBy: sum
		sourceColumn: AcceptedQuantity

	column RejectedQuantity
		dataType: double
		formatString: #,##0.00
		lineageTag: 049b27ba-2211-4f1d-9ba3-91ac3fedc2b8
		summarizeBy: sum
		sourceColumn: RejectedQuantity

	column ScrappedQuantity
		dataType: double
		formatString: #,##0.00
		lineageTag: 08283b33-20df-40ba-92ed-ecfd4887a04e
		summarizeBy: sum
		sourceColumn: ScrappedQuantity

	column ReturnedQuantity
		dataType: double
		formatString: #,##0.00
		lineageTag: d8da5cbc-0e06-44e0-8c65-ffbd9ff4323e
		summarizeBy: sum
		sourceColumn: ReturnedQuantity

	column ReworkQuantity
		dataType: double
		formatString: #,##0.00
		lineageTag: 7b84ded3-4075-472e-a08e-8d1905ffcb41
		summarizeBy: sum
		sourceColumn: ReworkQuantity

	column BaseUoM
		dataType: string
		lineageTag: f85fb1c5-742e-4471-9e0a-c1c0c2896010
		summarizeBy: none
		sourceColumn: BaseUoM

	/// Created / In Inspection / UD Pending / UD Completed / Cancelled.
	column LotStatus
		dataType: string
		lineageTag: ddce5ce6-7b8a-43a3-bca8-753ae71da59b
		summarizeBy: none
		sourceColumn: LotStatus

	/// Storage type the failed material was moved to (Y105 / Y106). Empty when the lot passed.
	column QuarantineStorageType
		dataType: string
		lineageTag: a17d8057-d32e-4969-bb16-de630ff82b8f
		summarizeBy: none
		sourceColumn: QuarantineStorageType

	column IsUDCompleted
		dataType: boolean
		lineageTag: b52731ff-0732-451e-b76b-f36de21f40f3
		summarizeBy: none
		sourceColumn: IsUDCompleted

	column IsPendingUD
		dataType: boolean
		lineageTag: 42e533ff-09a9-418c-8f29-1bf8813e2604
		summarizeBy: none
		sourceColumn: IsPendingUD

	column IsPass
		dataType: boolean
		lineageTag: 6fd020e4-3ea8-4d0d-b411-4d34a3b70528
		summarizeBy: none
		sourceColumn: IsPass

	column IsFail
		dataType: boolean
		lineageTag: a4302d07-2eba-482f-9650-d5e941eda6cd
		summarizeBy: none
		sourceColumn: IsFail

	column GRTimestamp
		dataType: dateTime
		formatString: General Date
		lineageTag: 0d7bc2aa-0840-46c4-9be9-88606329a700
		summarizeBy: none
		sourceColumn: GRTimestamp

	column InspectionStartTimestamp
		dataType: dateTime
		formatString: General Date
		lineageTag: e8a63bb6-48de-4bc0-be3c-1b5d815ebabc
		summarizeBy: none
		sourceColumn: InspectionStartTimestamp

	column InspectionEndTimestamp
		dataType: dateTime
		formatString: General Date
		lineageTag: b66140e6-8b0c-45af-879f-3620624b94dd
		summarizeBy: none
		sourceColumn: InspectionEndTimestamp

	column UDTimestamp
		dataType: dateTime
		formatString: General Date
		lineageTag: 9eb1a96a-c0c2-45f4-9c01-b1b5ab2b9485
		summarizeBy: none
		sourceColumn: UDTimestamp

	/// Inspection end minus inspection start, in days. Pre-calculated in the Gold layer because Direct Lake cannot use DAX calculated columns here.
	column InspectionLeadTimeDays
		dataType: double
		formatString: #,##0.0
		lineageTag: ae1a43b8-a0b8-43f1-b2d7-fc83b9f7b387
		summarizeBy: none
		sourceColumn: InspectionLeadTimeDays

	/// Usage decision timestamp minus goods receipt timestamp, in days. Pre-calculated in the Gold layer.
	column UDLeadTimeDays
		dataType: double
		formatString: #,##0.0
		lineageTag: b0efc768-06a1-4643-9444-b4645c982ea4
		summarizeBy: none
		sourceColumn: UDLeadTimeDays

	/// Days the lot has spent in quality inspection stock as of the last refresh. Pre-calculated in the Gold layer.
	column QStockAgingDays
		dataType: double
		formatString: #,##0.0
		lineageTag: 34b9c313-8d07-40e5-a309-d3c8c90b4c4a
		summarizeBy: none
		sourceColumn: QStockAgingDays

	column InspectorId
		dataType: string
		lineageTag: 28ba4af1-0985-400a-adda-b7a10f4b0929
		summarizeBy: none
		sourceColumn: InspectorId

	column InspectorName
		dataType: string
		lineageTag: e28e5988-5614-4d1a-860f-0bff3c77b21b
		summarizeBy: none
		sourceColumn: InspectorName

	column UDDecisionBy
		dataType: string
		lineageTag: fd55eb72-0f60-4c0d-a1d5-3a221ff1c7cc
		summarizeBy: none
		sourceColumn: UDDecisionBy

	/// MES / ERP / EWM - the system the row was sourced from.
	column SourceSystem
		dataType: string
		lineageTag: 1c17b262-c2c6-4d98-993e-a8920d7ab7be
		summarizeBy: none
		sourceColumn: SourceSystem

	/// Number of inspection lots in the current filter context (grain of the fact table).
	measure 'Inspection Lots' = ```
			COUNTROWS ( 'Inspection Lot' )
			```
		formatString: #,##0
		lineageTag: 65f778b2-b0d3-4a7e-9c86-037837cf8c79
		displayFolder: 01 Volume

	/// Lots that have been created but have no usage decision yet - material still sitting in Q stock.
	measure 'Lots Pending UD' = ```
			CALCULATE ( [Inspection Lots], 'Inspection Lot'[IsPendingUD] = TRUE () )
			```
		formatString: #,##0
		lineageTag: 4bc09676-11ce-4659-9ded-a8539395f9a8
		displayFolder: 01 Volume

	/// Lots with a passing usage decision, released for putaway.
	measure 'Lots Passed' = ```
			CALCULATE ( [Inspection Lots], 'Inspection Lot'[IsPass] = TRUE () )
			```
		formatString: #,##0
		lineageTag: c4fda6bf-a650-4f52-a3e5-9e6bd2d7c3c9
		displayFolder: 01 Volume

	/// Lots with a failing usage decision; these must be moved to the Y105/Y106 quarantine area.
	measure 'Lots Failed' = ```
			CALCULATE ( [Inspection Lots], 'Inspection Lot'[IsFail] = TRUE () )
			```
		formatString: #,##0
		lineageTag: c73b99c0-9fc8-4d7f-8935-8de56c1ede8a
		displayFolder: 01 Volume

	/// Lots with a completed usage decision. Denominator for the UD pass rate.
	measure 'Lots Decided' = ```
			[Lots Passed] + [Lots Failed]
			```
		formatString: #,##0
		lineageTag: d04f3a16-da35-4133-8a6c-887e25077885
		displayFolder: 01 Volume

	/// Quantity actually inspected across all lots, in base unit of measure.
	measure 'Inspected Qty' = ```
			SUM ( 'Inspection Lot'[InspectedQuantity] )
			```
		formatString: #,##0.00
		lineageTag: 644d862e-d64c-465b-abaa-3a71c6f73eaf
		displayFolder: 01 Volume

	/// Quantity accepted by the usage decision and released to unrestricted stock.
	measure 'Accepted Qty' = ```
			SUM ( 'Inspection Lot'[AcceptedQuantity] )
			```
		formatString: #,##0.00
		lineageTag: c914d316-e8d7-4f64-b180-a6983937b268
		displayFolder: 01 Volume

	/// Quantity rejected by the usage decision.
	measure 'Rejected Qty' = ```
			SUM ( 'Inspection Lot'[RejectedQuantity] )
			```
		formatString: #,##0.00
		lineageTag: 11f4e229-5fca-4909-8f7a-91be7693af1c
		displayFolder: 01 Volume

	/// Quantity scrapped after a failing usage decision (process 04 step 19).
	measure 'Scrapped Qty' = ```
			SUM ( 'Inspection Lot'[ScrappedQuantity] )
			```
		formatString: #,##0.00
		lineageTag: 20e19c22-87a7-4824-8e70-050f461fc5a6
		displayFolder: 01 Volume

	/// Quantity returned to the vendor after a failing usage decision.
	measure 'Returned Qty' = ```
			SUM ( 'Inspection Lot'[ReturnedQuantity] )
			```
		formatString: #,##0.00
		lineageTag: 4b5da5b8-dda1-462a-9b49-b4ec9c46f3fd
		displayFolder: 01 Volume

	/// Share of decided lots that passed. Lots still pending a usage decision are excluded.
	measure 'UD Pass Rate %' = ```
			DIVIDE ( [Lots Passed], [Lots Decided] )
			```
		formatString: 0.0%
		lineageTag: 95f71503-4f6b-4c59-ab3e-e37d91366b9c
		displayFolder: 02 Quality

	/// Share of decided lots that failed the usage decision.
	measure 'Lot Reject Rate %' = ```
			DIVIDE ( [Lots Failed], [Lots Decided] )
			```
		formatString: 0.0%
		lineageTag: 59ae3343-efdf-4146-bed3-bd76e4facec3
		displayFolder: 02 Quality

	/// Rejected quantity as a share of inspected quantity.
	measure 'Qty Reject Rate %' = ```
			DIVIDE ( [Rejected Qty], [Inspected Qty] )
			```
		formatString: 0.0%
		lineageTag: 92a7baf3-7942-4bf0-bcf8-7f376356cf6a
		displayFolder: 02 Quality

	/// Defective parts per million, based on rejected versus inspected quantity.
	measure 'DPPM' = ```
			DIVIDE ( [Rejected Qty], [Inspected Qty] ) * 1000000
			```
		formatString: #,##0
		lineageTag: e83ed706-c0bb-4f32-9309-e956fdd7561a
		displayFolder: 02 Quality

	/// Total defective quantity recorded against defect codes.
	measure 'Defect Qty' = ```
			SUM ( 'Inspection Defect'[DefectQuantity] )
			```
		formatString: #,##0.00
		lineageTag: 7f13c983-be3e-41ad-8ddc-be4d96961f12
		displayFolder: 02 Quality

	/// Defective quantity attributed to critical defect codes.
	measure 'Critical Defect Qty' = ```
			CALCULATE ( [Defect Qty], 'Defect Code'[IsCritical] = TRUE () )
			```
		formatString: #,##0.00
		lineageTag: 7e425ba0-e686-4c30-993d-429df720d8b7
		displayFolder: 02 Quality

	/// Number of lots with at least one recorded defect. The lot fact filters the defect fact, so this respects every lot-level slicer.
	measure 'Lots With Defects' = ```
			DISTINCTCOUNT ( 'Inspection Defect'[InspectionLotKey] )
			```
		formatString: #,##0
		lineageTag: edfa9e53-41e0-49d6-bca0-320fedaaef58
		displayFolder: 02 Quality

	/// Share of lots that recorded no defect at all. Complements the UD pass rate by counting lots that were released but still had findings.
	measure 'First Pass Yield %' = ```
			DIVIDE (
			    [Inspection Lots] - [Lots With Defects],
			    [Inspection Lots]
			)
			```
		formatString: 0.0%
		lineageTag: 6221c02f-6407-4d82-b354-b8f25fbdbbed
		displayFolder: 02 Quality

	/// Share of measured characteristics that fell outside specification. Use it to find which MIC drives the rejections rather than which lot.
	measure 'Characteristic Reject Rate %' = ```
			VAR Results = COUNTROWS ( 'Inspection Result' )
			VAR Rejected =
			    CALCULATE (
			        COUNTROWS ( 'Inspection Result' ),
			        'Inspection Result'[IsRejected] = TRUE ()
			    )
			RETURN
			    DIVIDE ( Rejected, Results )
			```
		formatString: 0.0%
		lineageTag: 58228894-fa5a-496a-887c-c09054dc68de
		displayFolder: 02 Quality

	/// Service level for closing a usage decision after goods receipt, in days. Change this single measure to re-baseline every SLA calculation.
	measure 'UD SLA Days' = ```
			3
			```
		formatString: #,##0
		lineageTag: de4f3678-aad1-4c6c-96e8-45524f8f2b80
		displayFolder: 03 Cycle Time

	/// Average days from inspection start to inspection end, pre-calculated in the Gold layer.
	measure 'Avg Inspection Lead Time (Days)' = ```
			AVERAGE ( 'Inspection Lot'[InspectionLeadTimeDays] )
			```
		formatString: #,##0.0
		lineageTag: b9ddbd99-5efc-4121-a8c8-2eabaed3cd88
		displayFolder: 03 Cycle Time

	/// Average days from goods receipt to usage decision - the end-to-end IQC release time.
	measure 'Avg UD Lead Time (Days)' = ```
			AVERAGE ( 'Inspection Lot'[UDLeadTimeDays] )
			```
		formatString: #,##0.0
		lineageTag: a6e66c2a-552f-4a95-8798-e7f3888f63ba
		displayFolder: 03 Cycle Time

	/// Average age of material sitting in quality inspection stock.
	measure 'Avg Q-Stock Aging (Days)' = ```
			AVERAGE ( 'Inspection Lot'[QStockAgingDays] )
			```
		formatString: #,##0.0
		lineageTag: f8c25282-10d3-4540-a563-803137b9e816
		displayFolder: 03 Cycle Time

	/// Lots still waiting for a usage decision beyond the SLA. This is the escalation list for GAP-IQC-01, where inspection lots are created manually in ERP.
	measure 'Lots Overdue UD' = ```
			CALCULATE (
			    [Lots Pending UD],
			    KEEPFILTERS ( 'Inspection Lot'[QStockAgingDays] > [UD SLA Days] )
			)
			```
		formatString: #,##0
		lineageTag: 1db492c3-38b0-41bc-87c4-93a7cef69a4a
		displayFolder: 03 Cycle Time

	/// Share of decided lots closed within the UD SLA.
	measure 'UD On-Time Rate %' = ```
			VAR OnTime =
			    CALCULATE (
			        [Lots Decided],
			        KEEPFILTERS ( 'Inspection Lot'[UDLeadTimeDays] <= [UD SLA Days] )
			    )
			RETURN
			    DIVIDE ( OnTime, [Lots Decided] )
			```
		formatString: 0.0%
		lineageTag: c4894c0d-ebe2-4c7c-8a76-c8a0b9495f04
		displayFolder: 03 Cycle Time

	/// Lots counted on the usage decision date instead of the goods receipt date. Uses the inactive UDDateKey relationship.
	measure 'Inspection Lots by UD Date' = ```
			CALCULATE (
			    [Inspection Lots],
			    USERELATIONSHIP ( 'Inspection Lot'[UDDateKey], 'Date'[DateKey] )
			)
			```
		formatString: #,##0
		lineageTag: 32205d1f-723b-491f-9e16-34e641647e70
		displayFolder: 04 Time Intelligence

	/// Pass rate attributed to the month the decision was made, which is how quality reviews are usually run.
	measure 'UD Pass Rate % by UD Date' = ```
			CALCULATE (
			    [UD Pass Rate %],
			    USERELATIONSHIP ( 'Inspection Lot'[UDDateKey], 'Date'[DateKey] )
			)
			```
		formatString: 0.0%
		lineageTag: c9ee74fc-993d-45d9-996a-b4bcff53d21a
		displayFolder: 04 Time Intelligence

	/// Year-to-date lot count on the goods receipt date.
	measure 'Inspection Lots YTD' = ```
			TOTALYTD ( [Inspection Lots], 'Date'[Date] )
			```
		formatString: #,##0
		lineageTag: 843c3216-eeeb-4b31-9813-5b8bab283778
		displayFolder: 04 Time Intelligence

	/// Pass rate for the previous month.
	measure 'UD Pass Rate % PM' = ```
			CALCULATE (
			    [UD Pass Rate %],
			    DATEADD ( 'Date'[Date], -1, MONTH )
			)
			```
		formatString: 0.0%
		lineageTag: 3c98026f-a4a8-4e9d-9671-5b07db1c107f
		displayFolder: 04 Time Intelligence

	/// Month-over-month change in pass rate, expressed in percentage points.
	measure 'UD Pass Rate % MoM' = ```
			VAR CurrentRate = [UD Pass Rate %]
			VAR PriorRate = [UD Pass Rate % PM]
			RETURN
			    IF (
			        NOT ISBLANK ( CurrentRate ) && NOT ISBLANK ( PriorRate ),
			        CurrentRate - PriorRate
			    )
			```
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 31930c52-62f9-4e37-a2da-c44fddd36c2f
		displayFolder: 04 Time Intelligence

	partition 'Inspection Lot' = entity
		mode: directLake
		source
			entityName: fact_inspection_lot
			schemaName: dbo
			expressionSource: DatabaseQuery

	annotation PBI_ResultType = Table
