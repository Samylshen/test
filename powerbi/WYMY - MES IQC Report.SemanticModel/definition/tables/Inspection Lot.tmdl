/// Header fact at one row per inspection lot (process 04 - RM Inspection / IQC). Acts as the hub of the model: the dimensions filter this table, and it in turn filters the result and defect detail facts.
table 'Inspection Lot'
	lineageTag: 275a404d-0d72-4936-a545-f4ad9b24ea50

	/// Surrogate key, unique per lot. One side of the relationships to the result and defect facts.
	column InspectionLotKey
		dataType: int64
		isHidden: true
		formatString: 0
		lineageTag: 3819d27a-1761-4f12-a5f3-64685138c12a
		summarizeBy: none
		sourceColumn: InspectionLotKey

	/// ERP QM inspection lot number.
	column InspectionLotNumber
		dataType: string
		lineageTag: 5bc05bb8-fbaf-4ee6-9190-d3441b20427e
		summarizeBy: none
		sourceColumn: InspectionLotNumber

	/// QM inspection type, e.g. 01 for goods receipt inspection.
	column InspectionType
		dataType: string
		lineageTag: e0fe13f5-b692-4b53-8b6b-849a7de09604
		summarizeBy: none
		sourceColumn: InspectionType

	column MaterialKey
		dataType: int64
		isHidden: true
		formatString: 0
		lineageTag: 31bc5008-4499-4860-89bf-74e318ad8456
