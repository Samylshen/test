/// Raw material master (PN level), including the PACI classification that drives the putaway storage type.
table Material
	lineageTag: 74e359cf-4a39-4d48-8dcf-395a0fc9b519

	column MaterialKey
		dataType: int64
		isHidden: true
		formatString: 0
		lineageTag: 26aa9bd9-aa62-41d3-8053-54e08a424477
		summarizeBy: none
		sourceColumn: MaterialKey

	/// Wiwynn part number, e.g. B34.12345.6789.
	column MaterialNumber
		dataType: string
		lineageTag: 6baf61fe-fb45-43fa-8ac3-a3fdff9342f2
		summarizeBy: none
		sourceColumn: MaterialNumber

	column MaterialDescription
