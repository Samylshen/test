		lineageTag: 74086111-25a0-47e5-938f-cf5025e6f4a8
		summarizeBy: none
		sourceColumn: MaterialGroup

	/// PACI classification: HV / L10 / L11 / L11 Raw Rack / GPS. Drives the target storage type.
	column PACIClass
		dataType: string
		lineageTag: 0f39da55-4b8c-4584-85c5-84e1a330d9fd
		summarizeBy: none
		sourceColumn: PACIClass

	/// Putaway target storage type derived from PACI (HPR1 / SPR1 / EPR1 / ERR1 / GPSM).
	column TargetStorageType
